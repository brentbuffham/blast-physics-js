{
  "name": "blast-physics-js",
  "version": "0.5.0",
  "description": "JavaScript blast physics engine for mining — vibration, damage, detonation, flyrock, frequency analysis, ripple tank, KAP import and voxel blast movement (muckpile) models",
  "author": {
    "name": "Brent Buffham",
    "url": "https://blastingapps.com"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/blast-physics-js.cjs",
  "module": "dist/blast-physics-js.js",
  "exports": {
    ".": {
      "import": "./dist/blast-physics-js.js",
      "require": "./dist/blast-physics-js.cjs"
    },
    "./workers": {
      "import": "./src/workers/index.js"
    },
    "./src/*": {
      "import": "./src/*"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/",
    "src/",
    "CHANGELOG.md"
  ],
  "keywords": [
    "blast",
    "mining",
    "physics",
    "ppv",
    "vibration",
    "heelan",
    "blair",
    "minchinton",
    "flyrock",
    "detonation",
    "damage",
    "blast-movement",
    "grade-control",
    "explosives",
    "muckpile",
    "ripple-tank",
    "fft",
    "probability-of-exceedance",
    "sdob",
    "kap",
    "kirra",
    "signature-hole",
    "forward-array"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brentbuffham/blast-physics-js.git"
  },
  "homepage": "https://github.com/brentbuffham/blast-physics-js#readme",
  "bugs": {
    "url": "https://github.com/brentbuffham/blast-physics-js/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://buymeacoffee.com/brentbuffham"
  },
  "scripts": {
    "build": "vite build",
    "prepare": "vite build",
    "prepublishOnly": "vitest run",
    "build:pages": "vite build --config vite.pages.config.js && cp examples/SWELLFACTOR.kap dist-pages/",
    "dev": "vite examples --port 5175",
    "precompute": "node examples/precompute.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "lil-gui": "^0.21.0",
    "three": "^0.170.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
